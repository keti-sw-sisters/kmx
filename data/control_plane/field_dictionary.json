  ],
  "normalization_rules": {
    "alias_groups": [
      {
        "canonical_field": "temperature_c",
        "aliases": [
          "temp",
          "temperature",
          "chamber_temp",
          "t_ch",
          "temp_cell_max_c"
        ],
        "target_unit": "degC"
      },
      {
        "canonical_field": "pressure_kpa",
        "aliases": [
          "pressure",
          "press",
          "p_ch",
          "chamber_pressure_mtorr",
          "blast_pressure_kpa"
        ],
        "target_unit": "kPa"
      },
      {
        "canonical_field": "timestamp",
        "aliases": [
          "time",
          "ts",
          "datetime",
          "actual_start_dt",
          "actual_end_dt",
          "produced_at"
        ],
        "target_unit": null
      },
      {
        "canonical_field": "energy_kwh",
        "aliases": [
          "energy",
          "energy_wh",
          "energy_charged_kwh",
          "energy_per_unit_kwh"
        ],
        "target_unit": "kWh"
      }
    ],
    "unit_conversion": [
      {
        "from_unit": "degF",
        "to_unit": "degC",
        "formula": "(x - 32.0) * 5.0 / 9.0"
      },
      {
        "from_unit": "Wh",
        "to_unit": "kWh",
        "formula": "x / 1000.0"
      },
      {
        "from_unit": "kW",
        "to_unit": "W",
        "formula": "x * 1000.0"
      },
      {
        "from_unit": "mTorr",
        "to_unit": "kPa",
        "formula": "x * 0.000133322"
      }
    ],
    "time_alignment": {
      "default_timezone": "UTC",
      "resample": {
        "timeseries_default": "1s",
        "high_frequency": "100ms",
        "batch_default": "1h"
      },
      "windowing": {
        "default_window": "5m",
        "default_stride": "1m"
      }
    }
  },
  "preprocessing_rules": {
    "missing_value": {
      "numeric_default": "median",
      "categorical_default": "most_frequent",
      "max_missing_ratio": 0.3
    },
    "outlier_detection": {
      "default_method": "iqr",
      "iqr_multiplier": 1.5,
      "zscore_threshold": 3.5
    },
    "deduplication": {
      "default_keys": [
        "record_id",
        "timestamp"
      ],
      "strategy": "keep_latest"
    },
    "dtype_casting_priority": [
      "datetime",
      "float",
      "integer",
      "string",
      "boolean"
    ]
  },
  "fields": [
    {
