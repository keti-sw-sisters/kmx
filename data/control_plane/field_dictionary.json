{
  "version": "1.0.0",
  "updated_at": "2026-04-30T03:00:00Z",
  "description": "Canonical field dictionary for cross-industry metadata extraction, semantic tagging, ontology mapping, and preprocessing.",
  "naming_standard": {
    "case": "snake_case",
    "time_format": "ISO8601 UTC",
    "unit_suffix_examples": [
      "_c",
      "_kpa",
      "_pct",
      "_kwh",
      "_mm_s"
    ],
    "identifier_suffix_examples": [
      "_id",
      "_code",
      "_dt",
      "_at"
    ]
  },
