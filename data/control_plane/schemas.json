{
  "version": "1.0.0",
  "description": "Canonical JSON Schema bundle per dataset_id. Per-file copies under data/schemas/ remain as deprecated mirrors.",
  "schemas": {
    "auto-ev-bms-v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://kmx.local/schemas/auto_ev_bms.schema.json",
      "title": "Automotive EV BMS Telemetry",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "produced_at",
          "vin",
          "pack_id",
          "soc_pct",
          "soh_pct",
          "temperature_c",
          "vibration_mm_s",
          "power_watts",
          "status"
        ],
        "properties": {
          "record_id": { "type": "string" },
          "produced_at": { "type": "string", "format": "date-time" },
          "vin": { "type": "string", "minLength": 17, "maxLength": 17 },
          "pack_id": { "type": "string" },
          "robot_id": { "type": "string" },
          "station_id": { "type": "string" },
          "soc_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "soh_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "voltage_pack_v": { "type": "number" },
          "current_a": { "type": "number" },
          "temperature_c": { "type": "number" },
          "vibration_mm_s": { "type": "number" },
          "power_watts": { "type": "number" },
          "status": { "type": "string", "enum": ["RUNNING", "WARNING", "FAULT", "IDLE"] },
          "alarms": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "battery-pass-v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://kmx.local/schemas/battery_pass.schema.json",
      "title": "Battery Pass Core Dataset",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "battery_id",
          "manufacturer_id",
          "manufacturing_date",
          "capacity_kwh",
          "nominal_voltage_v",
          "chemistry",
          "soh_at_delivery_pct",
          "carbon_footprint_kg_co2eq",
          "catena_cx_digital_twin_id"
        ],
        "properties": {
          "battery_id": { "type": "string" },
          "manufacturer_id": { "type": "string" },
          "manufacturing_date": { "type": "string", "format": "date" },
          "manufacturing_place": { "type": "string" },
          "capacity_kwh": { "type": "number" },
          "nominal_voltage_v": { "type": "number" },
          "chemistry": { "type": "string" },
          "soh_at_delivery_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "cycle_life_expected": { "type": "integer", "minimum": 0 },
          "carbon_footprint_kg_co2eq": { "type": "number", "minimum": 0 },
          "recycled_content_cobalt_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "recycled_content_lithium_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "recycled_content_nickel_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "responsible_mining_cert": { "type": "string" },
          "hazardous_substance_list": {
            "type": "array",
            "items": { "type": "string" }
          },
          "catena_cx_digital_twin_id": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "steel-pcf-v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://kmx.local/schemas/steel_pcf.schema.json",
      "title": "Steel PCF and Energy Dataset",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "reporting_year",
          "facility_id",
          "co2_intensity_tcs",
          "scope1_emissions_mt",
          "energy_consumption_gj",
          "crude_steel_prod_mt"
        ],
        "properties": {
          "record_id": { "type": "string" },
          "reporting_year": { "type": "integer", "minimum": 2000 },
          "facility_id": { "type": "string" },
          "scope1_emissions_mt": { "type": "number", "minimum": 0 },
          "scope2_emissions_mt": { "type": "number", "minimum": 0 },
          "co2_intensity_tcs": { "type": "number", "minimum": 0 },
          "crude_steel_prod_mt": { "type": "number", "minimum": 0 },
          "energy_consumption_gj": { "type": "number", "minimum": 0 },
          "blast_furnace_route_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "eaf_route_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "renewable_energy_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "cbam_carbon_content": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  }
}
